# Original executable (PS-X EXE)
SLUS_013_*.23
SLUS01323*
*.exe

# Disc image / extracted assets / RAM dumps (all derived from the game)
*.bin
*.iso
*.img
*.idx
*.T
*.STR
*.XA
*.TIM
*.TMD
*.VAB
fdat_*
overlay_*

# Ghidra projects (contain disassembly of the copyrighted executable)
*.gpr
*.rep/
*.lock
*.gzf

# ──────────────────────────────────────────────────────────────────────────
# Build artifacts (regenerable from source)
# ──────────────────────────────────────────────────────────────────────────
*.o
*.elf
*.map

# ──────────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store

# Screenshots & Ghidra locks
shots/
*.lock~
*.lock

# Memory-card saves (player data)
*.mcs
*.mcd
*.gme
*.sav

# Raw VRAM/texture decodes (derived game assets) — local diagnostics only
docs/screens/menu_font_*.png
docs/screens/wordart_band_*.png
docs/screens/vram_full_*.png

# Extracted game text & inventories (derived copyrighted game content — never distribute)
disc_map/*_text.txt
disc_map/text_inventory.csv
disc_map/extracted/
# Exported meshes derived from game geometry (tools/pa_obj.py output) — never distribute
disc_map/*.obj
