# ──────────────────────────────────────────────────────────────────────────
# Copyrighted game data — NEVER commit. Bring your own legally-owned disc.
# ──────────────────────────────────────────────────────────────────────────
# Original executable (PS-X EXE)
SLUS_013_*.23
SLUS01323*
*.exe

# Disc image / extracted assets / RAM dumps (all derived from the game)
*.bin
*.iso
*.img
*.idx
*.T
*.STR
*.XA
*.TIM
*.TMD
*.VAB
fdat_*
overlay_*

# Ghidra projects (contain disassembly of the copyrighted executable)
*.gpr
*.rep/
*.lock
*.gzf

# ──────────────────────────────────────────────────────────────────────────
# Build artifacts (regenerable from source)
# ──────────────────────────────────────────────────────────────────────────
*.o
*.elf
*.map

# ──────────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store

# Screenshots & Ghidra locks
shots/
*.lock~
*.lock

# Memory-card saves (player data)
*.mcs
*.mcd
*.gme
*.sav

# Raw VRAM/texture decodes (derived game assets) — local diagnostics only
mods/farsi/docs/screens/menu_font_*.png
mods/farsi/docs/screens/wordart_band_*.png
mods/farsi/docs/screens/vram_full_*.png

# Extracted game text & inventories (derived copyrighted game content — never distribute)
disc_map/*_text.txt
disc_map/text_inventory.csv
disc_map/extracted/
# Decoded voice audio, clips, whisper/speaker caches and the generated review page
# (tools/audio pipeline) — game audio, never distribute
disc_map/extracted/AUDIO/
tools/audio/.venv/
# Exported meshes / renders derived from game geometry — never distribute
disc_map/*.obj
disc_map/**/*.obj
disc_map/**/*.png
# Carved code overlays + their manifest (extracted game code) — never distribute
disc_map/overlays/

# Compiled reference-model binaries (regenerable via `make` in re/)
re/build/
build/
disc_map/levels/
disc_map/levels_assembled/
ghidra_mission202/

# Personal scratch / throwaway working files (screenshots, experiments)
scratch/

# Byte-match toolchain (downloaded/built by tools/match/setup.sh, never vendored)
tools/match/vendor/

# AC1mod (tools/ac1mod) runtime output: per-BIN workspaces (extracted files, jPSXdec
# index, .ac1mod project), recent-file pointers, logs, venv and the host-compiled
# raster/XA hot-loop libraries
tools/ac1mod/*/
!tools/ac1mod/core/
tools/ac1mod/*.ac1mod
tools/ac1mod/recent_*.txt
tools/ac1mod/*.log
tools/ac1mod/core/libraster.*
tools/ac1mod/core/libxa.*

# objdiff workstation (tools/match/objdiff_prep.py): generated per machine
/objdiff.json
/build/objdiff/
