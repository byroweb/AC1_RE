# Raw VRAM/texture decodes (derived game assets) — local diagnostics only
docs/screens/menu_font_*.png
docs/screens/wordart_band_*.png
docs/screens/vram_full_*.png

# Extracted game text & inventories (derived copyrighted game content — never distribute)
disc_map/*_text.txt
disc_map/text_inventory.csv
disc_map/extracted/
# Exported meshes / renders derived from game geometry — never distribute
disc_map/*.obj
disc_map/**/*.obj
disc_map/**/*.png
# Carved code overlays + their manifest (extracted game code) — never distribute
disc_map/overlays/

# Compiled reference-model binaries (regenerable via `make` in re/)
re/build/
build/
disc_map/levels/
disc_map/levels_assembled/
ghidra_mission202/

# Personal scratch / throwaway working files (screenshots, experiments)
scratch/
