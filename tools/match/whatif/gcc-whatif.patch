diff --git a/toplev.c b/toplev.c
index bd4e650..e54f770 100644
--- a/toplev.c
+++ b/toplev.c
@@ -4034,3 +4034,75 @@ print_switch_values ()
 
   fprintf (stderr, "\n");
 }
+
+/* What-if knobs (tools/match/whatif/README.md).  Each reads one environment variable
+   holding `KEY[:VALUE],...` (KEY a pseudo register number or an insn uid, decimal or
+   0x hex; a bare KEY means VALUE 1).  With the variables unset cc1 behaves exactly
+   like the pinned build: these are diagnostics, never part of a match.  */
+extern char *getenv ();
+
+static char *
+whatif_num (s, v)
+     char *s;
+     long *v;
+{
+  int neg = 0, base = 10;
+  long n = 0;
+  if (*s == '-')
+    neg = 1, s++;
+  else if (*s == '+')
+    s++;
+  if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
+    base = 16, s += 2;
+  for (;;)
+    {
+      int c = *s, d;
+      if (c >= '0' && c <= '9')
+	d = c - '0';
+      else if (base == 16 && c >= 'a' && c <= 'f')
+	d = c - 'a' + 10;
+      else if (base == 16 && c >= 'A' && c <= 'F')
+	d = c - 'A' + 10;
+      else
+	break;
+      n = n * base + d;
+      s++;
+    }
+  *v = neg ? -n : n;
+  return s;
+}
+
+/* VALUE for KEY in the list in environment variable VAR, or DFLT.  */
+int
+whatif_value (var, key, dflt)
+     char *var;
+     int key, dflt;
+{
+  char *s = getenv (var);
+  long k, v;
+  if (s == 0)
+    return dflt;
+  while (*s)
+    {
+      s = whatif_num (s, &k);
+      v = 1;
+      if (*s == ':')
+	s = whatif_num (s + 1, &v);
+      if (k == key)
+	return (int) v;
+      while (*s && *s != ',')
+	s++;
+      if (*s == ',')
+	s++;
+    }
+  return dflt;
+}
+
+/* Nonzero when environment variable VAR is set to something other than "" or "0".  */
+int
+whatif_flag (var)
+     char *var;
+{
+  char *s = getenv (var);
+  return s != 0 && *s != 0 && !(s[0] == '0' && s[1] == 0);
+}
